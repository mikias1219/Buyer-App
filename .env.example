# ── Web app (Vite; these end up in the public bundle — never put secrets here) ──
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: error reporting
VITE_SENTRY_DSN=
# Dev only: run against the in-memory mock backend (ignored in production builds)
VITE_USE_MOCK=false

# ── Edge Function secrets (set with `supabase secrets set NAME=value`, NEVER commit) ──
# BOT_TOKEN=                    # from @BotFather
# JWT_SECRET=                   # Supabase → Project Settings → JWT Keys → Legacy JWT secret
# WEBHOOK_SECRET=               # random string; also passed to setWebhook as secret_token
# CRON_SECRET=                  # random string; sent as x-cron-secret by the scheduler
# MINI_APP_URL=                 # deployed web app URL, e.g. https://techmarket.vercel.app
# INITIAL_ADMIN_TELEGRAM_IDS=   # comma-separated; promotes on first login ONLY while no admin exists
# ALLOWED_ORIGINS=              # optional, comma-separated CORS allow-list (defaults to any)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.

# ── Operator scripts (local shell only) ──
# SUPABASE_DB_URL=              # postgres connection string, for migrations/backup during cutover
# SUPABASE_SERVICE_ROLE_KEY=    # only for scripts/migrate-legacy-images.mjs
